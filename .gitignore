# Dependencies
/target
**/*.rs.bk

# Rust build artifacts in app/android
app/android/**/build/
app/android/**/.cxx/

# Node / Tauri
node_modules/
dist/
.tauri/

# Kotlin / Gradle
.gradle/
local.properties

# Environment and secrets — never commit
.env
.env.local
*.keystore
*.jks
*.pem
*.key

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs and local state
*.log
himan.db
himan.db-shm
himan.db-wal

# SQLite durable state. The tests use temp dirs, so nothing should land in
# the repo, but a stray file must never be committed.
*.db
*.db-wal
*.db-shm

# Device enrollment: contains the enrolled device ids (public keys only, but
# treat as sensitive metadata). Never commit a real file.
enrolled-devices.json
*.enrolled.json

# Agent and orchestrator key material. Never commit.
*.seed
*.key

# Metrics output from the AC-6 example.
results/
